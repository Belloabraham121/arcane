{
  "name": "arcane-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "smoke:llm": "tsx scripts/smoke-llm-inference.ts",
    "smoke:llm:check": "tsx scripts/smoke-llm-inference.ts --check-only",
    "smoke:llm:tools": "tsx scripts/smoke-llm-inference.ts --method=inferToolsChat",
    "smoke:llm:trading": "tsx scripts/smoke-llm-trading.ts",
    "smoke:quickswap:pools": "tsx scripts/smoke-quickswap-pools.ts",
    "smoke:quickswap:quote": "tsx scripts/smoke-quickswap-quote.ts",
    "smoke:quickswap:swap-build": "tsx scripts/smoke-quickswap-swap-build.ts",
    "smoke:quickswap:route-planner": "tsx scripts/smoke-quickswap-route-planner.ts",
    "smoke:quickswap:liquidity-build": "tsx scripts/smoke-quickswap-liquidity-build.ts",
    "smoke:trading:cycle": "tsx scripts/smoke-trading-cycle.ts",
    "fork:anvil": "bash scripts/start-anvil-fork.sh",
    "fork:reset": "bash scripts/reset-anvil-fork.sh",
    "fork:find-whale": "tsx scripts/find-fork-whale.ts",
    "test": "RUN_INTEGRATION_TESTS=1 tsx --test tests/integration/**/*.test.ts tests/unit/**/*.test.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=1 tsx --test tests/integration/**/*.test.ts",
    "test:llm": "RUN_LLM_TESTS=1 tsx --test tests/integration/llm-*.test.ts",
    "demo:wallet": "tsx scripts/demo-email-wallet.ts",
    "db:generate": "prisma generate",
    "db:migrate-pools": "tsx scripts/migrate-pool-allocations.ts",
    "db:migrate-trading": "tsx scripts/migrate-trading-tables.ts",
    "db:migrate-account-mode": "tsx scripts/migrate-account-mode.ts",
    "db:migrate-account-mode-nullable": "tsx scripts/migrate-account-mode-nullable.ts",
    "db:migrate-portfolio-snapshots": "tsx scripts/migrate-portfolio-snapshots.ts",
    "db:migrate-trading-account-mode": "tsx scripts/migrate-trading-account-mode.ts",
    "db:migrate-strategy-account-mode": "tsx scripts/migrate-strategy-account-mode.ts",
    "db:push": "prisma db push",
    "db:upgrade": "npm run db:migrate-pools && npm run db:migrate-trading && npm run db:migrate-account-mode && npm run db:migrate-account-mode-nullable && npm run db:migrate-portfolio-snapshots && npm run db:migrate-trading-account-mode && npm run db:migrate-strategy-account-mode && npm run db:generate && prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@cryptoalgebra/integral-periphery": "^1.3.0-alpha.1",
    "@cryptoalgebra/integral-sdk": "^1.1.2",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.42.0",
    "socket.io": "^4.8.3",
    "viem": "^2.23.2",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
